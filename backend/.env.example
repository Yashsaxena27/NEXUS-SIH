# NEXUS SIH 2026 - Environment Variables Example
# Copy this file to .env and fill in the values

# Project Settings
PROJECT_NAME="NEXUS — Network Security Compliance Auditor"
DEBUG=True
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# AI Provider Settings
# Options: gemini, openai, claude
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
